{
  "version": 1,
  "profiles": {
    "python": {
      "platforms": [
        "linux",
        "win32"
      ],
      "build": [
        "{python}",
        "-m",
        "py_compile",
        "scripts/gen-edid.py"
      ],
      "test": [
        "{python}",
        "-m",
        "unittest",
        "discover",
        "-s",
        "scripts/tests",
        "-v",
        "-p",
        "test_gen_edid.py"
      ],
      "format": "unittest"
    },
    "shell": {
      "platforms": [
        "linux"
      ],
      "build": [
        "sh",
        "-n",
        "scripts/setup-evdi.sh"
      ],
      "test": [
        "{python}",
        "-m",
        "unittest",
        "discover",
        "-s",
        "scripts/tests",
        "-v",
        "-p",
        "test_evdi_setup.py"
      ],
      "format": "unittest"
    },
    "capture-c": {
      "platforms": [
        "linux"
      ],
      "build": [
        "cc",
        "-std=c11",
        "-O3",
        "-g",
        "-pthread",
        "-Wall",
        "-Wextra",
        "-Werror",
        "-fno-pie",
        "-no-pie",
        "-fsanitize=address,undefined",
        "-I",
        "host/evdi",
        "host/tests/conversion_test.c",
        "host/evdi/conversion.c",
        "host/evdi/frame_exchange.c",
        "-o",
        "{output}/conversion-build"
      ],
      "test": [
        "cargo",
        "test",
        "--locked",
        "--offline",
        "-p",
        "blent",
        "--test",
        "conversion"
      ],
      "format": "rust"
    },
    "kotlin": {
      "platforms": [
        "linux"
      ],
      "build": [
        "./android/gradlew",
        "-p",
        "android",
        "--offline",
        "--no-daemon",
        "--max-workers=4",
        "compileDebugUnitTestKotlin"
      ],
      "test": [
        "./android/gradlew",
        "-p",
        "android",
        "--offline",
        "--no-daemon",
        "--max-workers=4",
        "testDebugUnitTest",
        "--tests",
        "com.blent.RegressionTest.t123_updateVersionsFollowSharedValidationAndPrecedence"
      ],
      "format": "junit",
      "junit": "android/app/build/test-results/testDebugUnitTest/TEST-*.xml",
      "cache": "gradle"
    },
    "linux-include": {
      "platforms": [
        "linux"
      ],
      "build": [
        "cargo",
        "test",
        "--locked",
        "--offline",
        "-p",
        "blent",
        "--bin",
        "blent",
        "--no-run"
      ],
      "test": [
        "cargo",
        "test",
        "--locked",
        "--offline",
        "-p",
        "blent",
        "--bin",
        "blent",
        "--",
        "t511_tablet_routes_require_valid_non_loopback_ipv4"
      ],
      "format": "rust",
      "include_strategy": "Edit linux_main.rs directly; compile the original main.rs include! graph without rewriting cfg or crate roots."
    },
    "windows-tray": {
      "platforms": [
        "win32"
      ],
      "build": [
        "cargo",
        "test",
        "--locked",
        "--offline",
        "-p",
        "blent",
        "--lib",
        "--no-run"
      ],
      "test": [
        "cargo",
        "test",
        "--locked",
        "--offline",
        "-p",
        "blent",
        "--lib",
        "--",
        "tray_state::",
        "windows_tray::"
      ],
      "format": "rust",
      "isolation": "Native ordinary interactive session; only owned windows, icons, menus, fixture GUI process and watch channels."
    }
  },
  "mutations": [
    {
      "id": "PY01",
      "profile": "python",
      "language": "python",
      "file": "scripts/gen-edid.py",
      "before": "edid[127] = (256 - sum(edid[:127]) % 256) % 256",
      "after": "edid[127] = (255 - sum(edid[:127]) % 256) % 256",
      "expected_failure": "test_t321_",
      "operator": "arithmetic constant"
    },
    {
      "id": "PY02",
      "profile": "python",
      "language": "python",
      "file": "scripts/gen-edid.py",
      "before": "1 <= width_mm <= 4095",
      "after": "0 <= width_mm <= 4095",
      "expected_failure": "test_t321_invalid_physical",
      "operator": "lower-bound relaxation"
    },
    {
      "id": "SH01",
      "profile": "shell",
      "language": "shell",
      "file": "scripts/setup-evdi.sh",
      "before": "blent_wanted - blent_existing",
      "after": "blent_wanted + blent_existing",
