      "operator": "relational inversion"
    },
    {
      "id": "KT02",
      "profile": "kotlin",
      "language": "kotlin",
      "file": "android/app/src/main/java/com/blent/UpdateCheck.kt",
      "before": "it <= 0xffff_ffffL",
      "after": "it <= 0x1ffff_ffffL",
