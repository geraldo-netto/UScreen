[Desktop Entry]
Type=Application
Name=UScreen
Comment=Start the UScreen service with the desktop
# T536: Cinnamon may not activate graphical-session.target. Starting the same
# unit here is idempotent when the target has already started it.
Exec=/usr/bin/env systemctl --user start uscreen.service
Icon=uscreen
Terminal=false
StartupNotify=false
NoDisplay=true
