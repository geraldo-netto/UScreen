# T640: disposable GitHub runner only; allow the existing isolated test launcher.
abi <abi/4.0>,
include <tunables/global>
profile unshare /usr/bin/unshare flags=(unconfined) {
  userns,
}

# T652: the mutation runner also confines its normal regression fixtures.
profile blent-ci-bwrap /usr/bin/bwrap flags=(unconfined) {
  userns,
}
