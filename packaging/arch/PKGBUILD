# Maintainer: Geraldo Netto (https://github.com/geraldo-netto)
# Original upstream author: majmichu1
pkgname=blent
pkgver=1.2.3
pkgrel=1
pkgdesc="Use an Android tablet as a USB second display and graphics tablet (KDE Wayland)"
arch=('x86_64')
url="https://github.com/geraldo-netto/UScreen"
license=('MIT' 'LGPL-2.1-or-later')
depends=('evdi-dkms' 'ffmpeg' 'android-tools' 'libx11' 'libxcursor' 'libxi' 'libxkbcommon-x11')
makedepends=('cargo' 'gcc' 'pkgconf' 'libdrm')
install=blent.install
_evdi=v1.15.0
source=("$pkgname-$pkgver.tar.gz::https://github.com/geraldo-netto/UScreen/archive/refs/tags/v$pkgver.tar.gz"
        "evdi-$_evdi.tar.gz::https://github.com/DisplayLink/evdi/archive/refs/tags/$_evdi.tar.gz")
sha256sums=('SKIP' 'SKIP')

build() {
  cd "UScreen-$pkgver"
  cargo build --release --locked --target-dir target --manifest-path host/Cargo.toml
  cargo build --release --locked --target-dir target --manifest-path gui/Cargo.toml
  # libevdi built from upstream and shipped next to the helper (rpath $ORIGIN),
  # so the only thing the system must provide is the evdi kernel module.
  make -C "$srcdir/evdi-${_evdi#v}/library"
  gcc -O3 -Ihost/evdi -o host/evdi/evdi_helper host/evdi/evdi_helper.c host/evdi/conversion.c host/evdi/frame_exchange.c host/evdi/fifo_writer.c host/evdi/capture.c host/evdi/raw_ring.c host/evdi/writer.c \
      -L"$srcdir/evdi-${_evdi#v}/library" -levdi -lpthread -Wl,-rpath,'$ORIGIN'
}

package() {
  cd "UScreen-$pkgver"
  install -Dm755 scripts/setup-evdi.sh "$pkgdir/usr/share/blent/setup-evdi.sh"
  install -Dm755 target/release/blent     "$pkgdir/usr/bin/blent"
  install -Dm755 target/release/blent-gui "$pkgdir/usr/bin/blent-gui"
  install -Dm755 host/evdi/evdi_helper      "$pkgdir/usr/lib/blent/evdi_helper"
  install -Dm755 "$srcdir/evdi-${_evdi#v}/library/libevdi.so.1.15.0" "$pkgdir/usr/lib/blent/libevdi.so.1.15.0"
  ln -sf libevdi.so.1.15.0 "$pkgdir/usr/lib/blent/libevdi.so.1"
  install -Dm644 scripts/blent.desktop    "$pkgdir/usr/share/applications/blent.desktop"
  install -Dm644 packaging/icons/blent.svg     "$pkgdir/usr/share/icons/hicolor/scalable/apps/blent.svg"
  install -Dm644 packaging/icons/blent-pen.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/blent-pen.svg"
  install -Dm644 packaging/blent.service  "$pkgdir/usr/lib/systemd/user/blent.service"
  install -Dm644 packaging/blent-evdi.conf "$pkgdir/usr/lib/modprobe.d/blent-evdi.conf"
  install -Dm644 packaging/blent-modules.conf "$pkgdir/usr/lib/modules-load.d/blent.conf"
  install -Dm644 packaging/60-blent-uinput.rules "$pkgdir/usr/lib/udev/rules.d/60-blent-uinput.rules"
  ./scripts/copy-distribution-docs.sh "$pkgdir/usr/share/doc/blent"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 licenses/libevdi-LGPL-2.1.txt "$pkgdir/usr/share/licenses/$pkgname/libevdi-LGPL-2.1.txt"
}
