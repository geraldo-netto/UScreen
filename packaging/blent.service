[Unit]
Description=Blent — Android tablet as a second display
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
# T582: fair CPU preference for the complete capture/encode/helper group.
# The daemon applies the user's High/Normal preference at startup.
CPUWeight=1000
ExecStart=/usr/bin/blent start
ExecStop=/usr/bin/blent stop
# T268: longer than the CLI cleanup grace, bounded by the GUI action budget.
TimeoutStopSec=15
Restart=on-failure
RestartSec=3

[Install]
WantedBy=graphical-session.target
