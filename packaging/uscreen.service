[Unit]
Description=UScreen — Android tablet as a second display
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
ExecStart=/usr/bin/uscreen start
ExecStop=/usr/bin/uscreen stop
# T268: longer than the CLI cleanup grace, bounded by the GUI action budget.
TimeoutStopSec=15
Restart=on-failure
RestartSec=3

[Install]
WantedBy=graphical-session.target
